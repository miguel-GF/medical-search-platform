# Flutter does not load .env files automatically. Keep this file as the
# documented configuration inventory and pass the value with --dart-define.
API_BASE_URL="http://localhost:8787"
# Required for profile/release builds; comma-separated exact API hostnames.
API_ALLOWED_HOSTS="api.example.com"
# Anonymous events and offer-click metrics remain disabled unless explicitly enabled.
ANALYTICS_ENABLED="false"
# Provider UI and the ?provider=1 route are excluded unless explicitly enabled.
PROVIDER_PORTAL_ENABLED="false"
# Public HTTPS notice shown from Settings in PWA/Android release builds.
PRIVACY_POLICY_URL="https://example.com/privacidad"
# Leave empty until the mailbox or forwarding destination is verified.
SUPPORT_EMAIL=""
