# Optional real destinations. No server credentials belong in this application.
# Until reviewed public URLs are configured, the landing stays noindex and its
# main call-to-action points to the explanation on the page.
PRUEVIA_SITE_URL=
PRUEVIA_PATIENT_APP_ENABLED=false
PRUEVIA_PATIENT_URL=http://127.0.0.1:8080
PRUEVIA_SUPPORT_EMAIL=
PRUEVIA_INDEXABLE=false

# Provider access is a separate future release. A stale URL alone must never
# expose it: both this explicit gate and the destination are required.
PRUEVIA_PROVIDER_ACCESS_ENABLED=false
PRUEVIA_PROVIDER_URL=

# Closed Android tester intake. Keep false until the legal/contact fields and
# the matching database gate have been reviewed and activated.
PRUEVIA_API_URL=http://127.0.0.1:8787
PRUEVIA_TESTER_INTAKE_ENABLED=false
# Full legal name and a real address for receiving privacy notifications.
PRUEVIA_PRIVACY_CONTROLLER=
PRUEVIA_PRIVACY_ADDRESS=
PRUEVIA_PRIVACY_EMAIL=
PRUEVIA_TESTER_NOTICE_VERSION=android-testers-2026-09-v1
