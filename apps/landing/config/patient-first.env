# Public, non-secret production build profile. Legal identity/address are loaded
# from the ignored local .env by the release script; provider access stays closed.
PRUEVIA_SITE_URL=https://pruevia.com.mx
# Reapertura paciente autorizada en sesión (2026-10-15); compilar antes de publicar.
PRUEVIA_PATIENT_APP_ENABLED=true
PRUEVIA_PATIENT_URL=https://app.pruevia.com.mx
PRUEVIA_PROVIDER_ACCESS_ENABLED=false
PRUEVIA_PROVIDER_URL=
PRUEVIA_SUPPORT_EMAIL=contacto@pruevia.com.mx
PRUEVIA_INDEXABLE=false
PRUEVIA_API_URL=https://api.pruevia.com.mx
PRUEVIA_TESTER_INTAKE_ENABLED=false
PRUEVIA_PRIVACY_CONTROLLER=
PRUEVIA_PRIVACY_ADDRESS=
PRUEVIA_PRIVACY_EMAIL=contacto@pruevia.com.mx
PRUEVIA_TESTER_NOTICE_VERSION=android-testers-2026-09-v1
