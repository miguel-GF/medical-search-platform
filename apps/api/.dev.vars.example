SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
SUPABASE_SECRET_KEY="<server-only-secret-key>"
# Legacy compatibility only; prefer the two keys above.
# SUPABASE_ANON_KEY="<legacy-anon-key>"
# SUPABASE_SERVICE_ROLE_KEY="<legacy-service-role-key>"
SUPABASE_TIMEOUT_MS="5000"
APP_ENV="development"
API_VERSION="v1"
ALLOWED_ORIGIN="http://localhost:5173"
ADMIN_USER_IDS="<supabase-auth-user-uuid>"
OCR_AI_MODEL="@cf/moondream/moondream3.1-9B-A2B"
# Optional private FastAPI OCR service. When set, this takes precedence over Workers AI.
# OCR_SERVICE_URL="http://127.0.0.1:8000"
# OCR_SERVICE_TOKEN="server-only-shared-secret"
# OCR_SERVICE_TIMEOUT_MS="20000"
