# Copy this file to .env for local runs. Never commit the real .env.
DENUE_API_TOKEN=

# Optional LOINC release tooling. Keep these credentials local and never commit
# the real .env file. Process variables take precedence over these values.
# LOINC_USERNAME=
# LOINC_PASSWORD=

