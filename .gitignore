# Node dependency trees are restored from package-lock.json.
node_modules/

# Local environment and generated build output.
.env
.env.*
!.env.example
dist/
coverage/

# Collector outputs are reproducible but can be large and machine-local.
collectors/artifacts/

# LOINC releases and derived indexes require a free LOINC login and are kept
# machine-local; only mapping fixtures and import code belong in Git.
database/artifacts/loinc/

# Python bytecode generated by local tests and script checks.
__pycache__/
*.py[cod]
*.egg-info/
