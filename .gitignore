# Node dependency trees are restored from package-lock.json.
node_modules/

# Local environment and generated build output.
.env
.env.*
!.env.example

# Wrangler local development variables may contain Supabase service-role and
# other server-only secrets. Keep the real file local while versioning the
# explicitly named template.
.dev.vars
.dev.vars.*
!.dev.vars.example
dist/
coverage/

# Wrangler local runtime state and linked-project metadata.
apps/api/.wrangler/
apps/api/supabase/.temp/
**/supabase/.temp/

# Collector outputs are reproducible but can be large and machine-local.
collectors/artifacts/

# LOINC releases and derived indexes require a free LOINC login and are kept
# machine-local; only mapping fixtures and import code belong in Git.
database/artifacts/loinc/

# Python bytecode generated by local tests and script checks.
__pycache__/
*.py[cod]
*.egg-info/

# Crash/heap artifacts can contain request payloads or signing material.
*.hprof
*.dump
